# Ananta Quantum Studio - Local Environment Variables
#
# Copy this file to `.env` (already gitignored) and paste your real values
# in. Nothing here is required to run the app - each one just upgrades a
# specific feature from its honest offline fallback to the real thing.
# See README.md "Environment variables" for what each one enables.

# --- Database (Supabase Postgres) ---
# Project Settings -> Database -> Connection string -> "Transaction" pooler
# (port 6543). Required for real accounts / instructor data in production;
# without it, the app falls back to local JSON files (dev only).
DATABASE_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required whenever DATABASE_URL is set.
ANANTA_SESSION_SECRET=

# --- AI (Google AI Studio) ---
# https://aistudio.google.com/apikey
# Powers the real LLM-backed AI Circuit Tutor, voice parsing, research
# summarization, and (once ananta-backend/rag/buildIndex.js has been run)
# RAG retrieval over the knowledge corpus.
GEMINI_API_KEY=

# --- Optional: real cloud quantum hardware ---
# https://quantum.ibm.com/account
IBM_QUANTUM_TOKEN=

# https://account.qbraid.com
QBRAID_API_KEY=

# --- Optional: remote multi-framework execution service ---
# Only needed if you deployed ananta-backend/python/app.py separately
# (required on Vercel - see README). Leave blank for local dev, where a
# Python subprocess is spawned automatically instead.
MULTIFRAMEWORK_SERVICE_URL=
MULTIFRAMEWORK_SERVICE_TOKEN=
